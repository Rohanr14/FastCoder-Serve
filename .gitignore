# Large benchmark artifacts. Keep lightweight placeholders and explicit smoke outputs.
results/*
!results/.gitkeep
!results/local_smoke.json
!results/local_smoke_streaming.json
!results/pareto.png
!results/manifests/
results/manifests/*
!results/manifests/.gitkeep

# Docker/runtime noise
*.pid
docker/.env
